# ─── SERVER SIDE (never prefix with EXPO_PUBLIC_ — stays out of the app bundle) ─
# Get a free key at https://openrouter.io — the app uses free models only.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Shared secret between app and server — prevents unauthorized use of your AI endpoints.
# Set the same value in both SERVER_SECRET and EXPO_PUBLIC_API_SECRET.
SERVER_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=production

# ─── EXPO APP (compiled into bundle — visible in APK, but not a true secret) ────
# Update to your deployed server URL before running: eas build --profile production
# Example: https://famkids-server.railway.app
EXPO_PUBLIC_API_URL=http://localhost:3000
# Must match SERVER_SECRET above. Compiled into the app bundle.
EXPO_PUBLIC_API_SECRET=change-me-to-a-long-random-string
